{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dev-cycle E2E scenario",
  "type": "object",
  "required": ["name", "steps"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "requires": {
      "type": "object",
      "properties": {
        "seed": { "type": "string" },
        "auth": { "type": "string", "description": "storageState | jwt-inject | form-login | custom-script | none" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "navigate": { "type": ["string", "object"] },
          "wait": { "type": "object" },
          "click": { "type": "object", "properties": { "selector": { "type": "string" }, "text": { "type": "string" } } },
          "fill": { "type": "object", "required": ["value"], "properties": { "selector": { "type": "string" }, "value": { "type": "string" } } },
          "expect": { "type": "object", "properties": { "selector": { "type": "string" }, "visible": { "type": "boolean" }, "text": { "type": "string" } } },
          "ai_judge": { "type": "string" }
        }
      }
    }
  }
}
