{
  "provider": "github",
  "tracker": {
    "owner": "econ-v1",
    "repo": "node",
    "project": 9,
    "assignee": "@me",
    "statuses": ["Backlog", "Ready", "In progress", "In review", "Done"],
    "done_autocloses": true
  },
  "scm": {
    "branch_prefix": "NNN-kebab",
    "commit_convention": "conventional",
    "pr_closes_parent": true
  },
  "validation": {
    "provider": "node-validation",
    "driver": "chrome",
    "scenarios_dir": "e2e/scenarios"
  },
  "loops_default": ["speckit-implement", "review-code"]
}
